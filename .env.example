# Copie este arquivo para .env e ajuste para o seu PC/janela do jogo.
# Exemplo no PowerShell:
# Copy-Item .env.example .env

# Titulo da janela do jogo para foco/captura
FNAF_WINDOW_TITLE=Five Nights at Freddy's

# Caminho completo do jogo para fallback quando a janela fechar.
# Aceita .exe ou atalho .lnk (inclusive na area de trabalho com espacos/acentos).
# Exemplo: C:/Program Files (x86)/Steam/steamapps/common/Five Nights at Freddy's/FiveNightsatFreddys.exe
# Exemplo: C:/Users/seu_usuario/OneDrive/Desktop/Five Nights at Freddy's.lnk
FNAF_EXECUTABLE_PATH=C:\Users\lmaza\OneDrive\Área de Trabalho\FiveNightsatFreddys.exe

# Espera (segundos) apos abrir o executavel, antes de enviar ALT+ENTER
FNAF_REABRIR_ESPERA_SEGUNDOS=10

# Espera (segundos) apos ALT+ENTER para estabilizar modo janela
FNAF_POS_ALT_ENTER_ESPERA_SEGUNDOS=3

# Ajustes de timing da IA
# Delay entre steps (um pouco maior para reduzir a agitacao da IA)
FNAF_STEP_DELAY=0.35

# Ao trocar lado (esquerdo <-> direito), espera esse tempo apos mover o mouse
# antes de contar/executar o clique.
FNAF_SIDE_SWITCH_DELAY=0.85

# Ao sair das cameras para clicar em luz/porta direita, espera esse tempo
# antes de executar o clique para a camera do jogo acompanhar o movimento.
FNAF_CAMERA_EXIT_DELAY=0.65

# Arrasto do mouse para abrir/fechar a prancheta de cameras.
# O jogo exige movimento (nao teleporte) para revelar o botao.
# PIXELS: quantos pixels acima do botao o mouse parte antes de arrastar.
# DURATION: duracao do arrasto em segundos.
FNAF_CAMERA_DRAG_PIXELS=80
FNAF_CAMERA_DRAG_DURATION=0.15

# Botoes do menu (obrigatorios) — calibre os dois com: python -m src.utils.calibrar_por_passos
# New Game = zera o save p/ Noite 1 ; Continue = retoma a noite onde morreu. Ajuste pro seu jogo.
FNAF_NEW_GAME_CLICK_X=464
FNAF_NEW_GAME_CLICK_Y=596

FNAF_CONTINUE_CLICK_X=464
FNAF_CONTINUE_CLICK_Y=596

# Metodo de reset (Decisao 7) — o MENU so aparece depois de MORRER (vencer emenda direto na
# proxima noite, sem menu). A escolha New Game vs Continue so ocorre na morte. Valores aceitos:
#   FNAF_RESET_METODO=new_game  -> curriculo classico: morte -> New Game (Noite 1) ; vitoria -> proxima noite.
#   FNAF_RESET_METODO=continue  -> MIRA FNAF_NOITE_DESEJADA: morte na/abaixo da alvo -> Continue (retoma a noite),
#                                  morte ACIMA da alvo -> New Game (reescala do 1). Vencer a alvo obriga jogar
#                                  D+1 ate morrer (auto-avanco, sem menu pra voltar antes).
# O 1o reset de cada execucao SEMPRE faz New Game (ancora o save na Noite 1).
FNAF_RESET_METODO=continue
# Noite alvo INICIAL do modo continue (1..7). O modo new_game ignora. O CurriculumCallback
# promove sozinho (FNAF_CURRICULO_LIMIAR, default 50% na janela de 30 eps da noite alvo) e
# persiste o alvo em modelos/curriculo.json — ao retomar vale max(este valor, json).
FNAF_NOITE_DESEJADA=1
# Espera (s) apos uma vitoria, enquanto o jogo avanca sozinho pra proxima noite (6AM -> intro).
FNAF_VITORIA_ESPERA_SEGUNDOS=20

# ── Hiperparametros de treino e ALGORITMO: no CODIGO, nao no .env ──
# O algoritmo (LSTM vs feedforward = USAR_LSTM) e TODO o tuning (entropia, pesos do shaping Phi,
# warmup do critico, ancora BC, n_steps, curriculo...) sao CONSTANTES em src/agent/train.py e
# src/environment/fnaf_env.py. Nao variam por dispositivo -> ficam no codigo, e o git leva a
# mudanca pros 2 PCs (evita o drift de .env que ja fez prod rodar a config errada). Ajuste-os la.
# No .env fica so o que varia por maquina: janela, caminho, teclas, coordenadas, timings, PC,
# Mongo — e os dois alvos de TESTE acima (FNAF_RESET_METODO / FNAF_NOITE_DESEJADA).

# Coordenadas das acoes do agente
FNAF_COORD_PORTA_ESQUERDA_X=256 
FNAF_COORD_PORTA_ESQUERDA_Y=514

FNAF_COORD_PORTA_DIREITA_X=1415
FNAF_COORD_PORTA_DIREITA_Y=530

FNAF_COORD_LUZ_ESQUERDA_X=253
FNAF_COORD_LUZ_ESQUERDA_Y=621

FNAF_COORD_LUZ_DIREITA_X=1318
FNAF_COORD_LUZ_DIREITA_Y=641

FNAF_COORD_ABRIR_FECHAR_CAMERA_X=818
FNAF_COORD_ABRIR_FECHAR_CAMERA_Y=832

FNAF_COORD_CAMERA_1A_X=1191
FNAF_COORD_CAMERA_1A_Y=530

FNAF_COORD_CAMERA_1B_X=1169
FNAF_COORD_CAMERA_1B_Y=585

FNAF_COORD_CAMERA_1C_X=1130
FNAF_COORD_CAMERA_1C_Y=657

FNAF_COORD_CAMERA_2A_X=1179
FNAF_COORD_CAMERA_2A_Y=773

FNAF_COORD_CAMERA_2B_X=1183
FNAF_COORD_CAMERA_2B_Y=813

FNAF_COORD_CAMERA_3_X=1092
FNAF_COORD_CAMERA_3_Y=759

FNAF_COORD_CAMERA_4A_X=1292
FNAF_COORD_CAMERA_4A_Y=776

FNAF_COORD_CAMERA_4B_X=1281
FNAF_COORD_CAMERA_4B_Y=815

FNAF_COORD_CAMERA_5_X=1058
FNAF_COORD_CAMERA_5_Y=610

FNAF_COORD_CAMERA_6_X=1375
FNAF_COORD_CAMERA_6_Y=748

FNAF_COORD_CAMERA_7_X=1390
FNAF_COORD_CAMERA_7_Y=610

PC = pc2

# MongoDB (usado pelo script scripts/enviar_logs_mongodb.py)
# Exemplo de URI: mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DATABASE=no_more_jumpscares
MONGO_COLLECTION=treino_logs

# Opcional: sobrescreve o identificador para agrupar a mesma execucao de envio
SESSAO_TREINO_ID=
